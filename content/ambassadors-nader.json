    {
      "id": "abu-dhabi",
      "type": "clip",
      "video": "assets/footage/ambassador-abu-dhabi.mp4",
      "duration": 39.1,
      "subtitle_font_size": 36,
      "subtitles": [
        {"start": 1.36, "end": 2.5, "text": "평화가 함께하시길 바랍니다."},
        {"start": 2.66, "end": 7.54, "text": "안녕하세요, 여러분. 저는 함자 알카마르입니다.\n아랍에미리트 아부다비에서 Devin 앰버서더로 활동하고 있어요."},
        {"start": 7.62, "end": 11.4, "text": "재미있는 얘기 하나 하자면, 지금도 Devin이 열심히 일하고 있어요."},
        {"start": 11.64, "end": 15.12, "text": "제 업무에 쓸 맞춤형 대시보드를 만들고 있거든요."},
        {"start": 15.52, "end": 19.85, "text": "보시다시피 Devin은 이미 제 일하는 방식의 일부가 됐습니다."},
        {"start": 20.1, "end": 21.98, "text": "여러분도 그렇게 활용해 보시면 좋겠어요."},
        {"start": 22.22, "end": 24.96, "text": "다시 한번 Devin 커뮤니티에 오신 걸 환영합니다."},
        {"start": 24.96, "end": 31.8, "text": "소프트웨어 엔지니어링의 새로운 흐름에\n함께해 주셔서 감사합니다."},
        {"start": 31.92, "end": 38.7, "text": "그리고 Devin 앰버서더로 누구보다 활발히 활동해 주시는\n제임스에게도 감사드립니다."}
      ]
    },
    {
      "id": "nader-dabit",
      "type": "clip",
      "video": "assets/footage/nader-dabit-welcome.mp4",
      "duration": 60.2,
      "subtitle_font_size": 36,
      "subtitles": [
        {"start": 0, "end": 0.72, "text": "여러분, 안녕하세요!"},
        {"start": 0.72, "end": 1.94, "text": "저는 Nader Dabit입니다."},
        {"start": 1.94, "end": 4, "text": "Cognition의 Devin 팀에서 일하고 있습니다."},
        {"start": 4, "end": 7, "text": "오늘 저녁 이 자리에 함께해 주셔서 진심으로 감사드립니다."},
        {"start": 7, "end": 8.94, "text": "여러분이 Devin을 직접 경험하게 되어 매우 기쁩니다."},
        {"start": 8.94, "end": 10.68, "text": "저희는 Devin을 개발하는 데 많은 노력을 기울여 왔습니다."},
        {"start": 10.68, "end": 17, "text": "최근 몇 주 동안 다양한 멋진 기능들이 출시되었고, 오늘 저녁 여러분이 직접 경험해 보실 수 있습니다."},
        {"start": 17, "end": 23.76, "text": "오늘 여러분께 한 가지 조언을 드리고 싶습니다. 여러분이 생각하는 것보다 더 과감하게 도전해 보세요."},
        {"start": 23.76, "end": 25.72, "text": "Devin에게 단순하고 작은 작업만 맡기지 마세요."},
        {"start": 25.72, "end": 30.52, "text": "그동안 미뤄왔던 큰 프로젝트나 시간이 부족해 완성하지 못했던 아이디어를 가져오세요."},
        {"start": 30.52, "end": 36, "text": "원하는 최종 결과가 무엇인지 Devin에게 알려주고, 그 과정은 Devin이 스스로 찾아가도록 맡겨보세요."},
        {"start": 36, "end": 38.86, "text": "우리가 소프트웨어를 개발하는 방식은 빠르게 변화하고 있습니다."},
        {"start": 38.86, "end": 43.9, "text": "우리는 ‘어떻게 만들 것인가’에 쓰는 시간을 줄이고, ‘무엇을 만들 가치가 있는가’를 결정하는 데 더 많은 시간을 쓰고 있습니다."},
        {"start": 43.9, "end": 47.42, "text": "오늘 저녁은 여러분이 이러한 변화를 직접 체감할 수 있는 기회입니다."},
        {"start": 47.42, "end": 55, "text": "좋았던 점과 아쉬웠던 점 모두 저희에게 알려주세요. 여러분의 피드백은 Devin의 미래를 만들어가고 더욱 발전시키는 데 큰 도움이 됩니다."},
        {"start": 55, "end": 56.62, "text": "다시 한번 오늘 함께해 주셔서 감사합니다."},
        {"start": 56.62, "end": 59.26, "text": "즐거운 시간 보내시고, 여러분이 무엇을 만들어낼지 기대하겠습니다!"}
      ]
    }
  ]
